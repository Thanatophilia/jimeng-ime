<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音输入：离线 SenseVoice 引擎要开麦 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 扩展商店：模型不随 APK 走，用户点了才下载 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.JiMeng">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ClipboardEditActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <activity
            android:name=".SkinActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <!-- 键盘管理：键盘尺寸 + 空格键上的字，独立一页 -->
        <activity
            android:name=".KeyboardActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <!-- 模型管理：看已装的模型、删、重新加载引擎 -->
        <activity
            android:name=".ModelManagerActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <!-- 插件管理：插件下载在商店，开不开在这里 -->
        <activity
            android:name=".PluginManagerActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.JiMeng" />
        <!--
          录音权限的透明宿主。输入法自己弹不出系统权限对话框，
          只能靠这个空 Activity 去要；用户答完立刻 finish，回到键盘。

          excludeFromRecents + noHistory：不要在最近任务里留一条「霁梦」，
          用户会以为是误开了应用。
        -->
        <activity
            android:name=".voice.VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".JimengIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>